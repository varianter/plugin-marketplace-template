{
  "name": "@variant/claude-plugin-workspace",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "type": "module",
  "scripts": {
    "dev": "tsx ./scripts/run-plugin-script.ts dev",
    "dev:server": "tsx ./scripts/run-plugin-script.ts dev:server",
    "build": "pnpm --filter './plugins/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm typecheck && pnpm check && pnpm validate-skills && pnpm test",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check . --fix",
    "validate-skills": "tsx ./scripts/validate.ts",
    "validate-skill": "tsx ./scripts/validate.ts"
  },
  "devDependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-secrets": "4.11.2",
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
