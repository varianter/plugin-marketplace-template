{
  "name": "@variant/claude-plugin-workspace",
  "private": true,
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "type": "module",
  "scripts": {
    "dev:standard": "pnpm --filter @variant/plugin-standard run dev",
    "dev:server:standard": "pnpm --filter @variant/plugin-standard run dev:server",
    "build": "pnpm --filter @variant/mcp-server run build && pnpm --filter @variant/plugin-standard run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm typecheck && pnpm check && pnpm validate-skills && pnpm test",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check . --fix",
    "validate-skills": "tsx ./scripts/validate.ts"
  },
  "devDependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-secrets": "4.11.2",
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "@types/supertest": "^7.2.0",
    "@variant/mcp-server": "workspace:*",
    "supertest": "^7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
