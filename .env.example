# Copy to .env for local development. Never commit .env.
#
# HOST: use 127.0.0.1 locally (production uses 0.0.0.0 via container env)
HOST=127.0.0.1
PORT=8080
MCP_PATH=/mcp

# CORS — set to * locally so browser-based MCP inspectors (mcpjam) can connect.
# Leave unset in production where no browser clients are used.
CORS_ORIGIN=*

# Key Vault — used by `pnpm kv` to load secrets into this .env file for local dev.
# Run `az login` first, then `pnpm kv`. Not read by the server itself.
KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Public base URL for OAuth discovery.
# Set to the externally-reachable URL in production (e.g. https://mcp.example.com).
# Defaults to http://{HOST}:{PORT} when unset — correct for local dev.
# PUBLIC_URL=

# Trust proxy — how many hops to trust for X-Forwarded-* headers.
# 1 = trust one load balancer (production default). false = disable (direct only).
# TRUST_PROXY=1

# MCP server metadata — defaults to .claude-plugin/plugin.json + package.json.
# MCP_SERVER_NAME=
# MCP_SERVER_TITLE=
# MCP_SERVER_DESCRIPTION=
# MCP_SERVER_VERSION=

# Session and rate limit tuning.
# MCP_MAX_SESSIONS=200
# RATE_LIMIT_REQUESTS_PER_MINUTE=60


## OAuth / OIDC auth
## See mcp/docs/entra-setup.md for Microsoft Entra ID setup instructions.
#
# AUTH_PROVIDER=entra          # generic-oidc | oidc | entra | auth0 | okta | keycloak | cognito | zitadel
# AUTH_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_AUDIENCE=               # defaults to AUTH_CLIENT_ID; Entra also accepts api://AUTH_CLIENT_ID
# AUTH_ACCEPTED_AUDIENCES=     # comma-separated extra JWT audiences to accept
# AUTH_ACCEPTED_ISSUERS=       # comma-separated extra JWT issuers to accept
# AUTH_SCOPES=openid profile email offline_access
# AUTH_CLIENT_REGISTRATION=provider # provider | static | none. Use static for Claude when IdP lacks dynamic registration.
# AUTH_COMPATIBILITY_PROXY=true  # default true for Entra; proxies /authorize and /token locally as last resort

# Entra: additional scope names to rewrite to {clientId}/.default in the compatibility proxy.
# Comma-separated. Default empty. Example for Claude.ai integration: claudeai
# AUTH_SCOPE_ALIASES=claudeai

# Allowed OAuth redirect URI prefixes (comma-separated).
# Defaults to localhost + https://claude.ai — override to restrict in production.
# AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost,http://127.0.0.1,https://claude.ai
