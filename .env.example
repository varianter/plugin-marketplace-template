# Copy to .env for local development. Never commit .env.
#
# HOST: use 127.0.0.1 locally (AKS uses 0.0.0.0 via ConfigMap)
HOST=127.0.0.1
PORT=8080
MCP_PATH=/mcp

# CORS — set to * locally so browser-based MCP inspectors (mcpjam) can connect.
# Leave unset in production (AKS/k8s) where no browser clients are used.
CORS_ORIGIN=*

# Key Vault — set this locally to fetch secrets via DefaultAzureCredential (az login).
KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/


## These are documentations for if needed to override Key Vault
#
#
# Azure auth — in k8s these are injected as env vars from values.yaml.
# Locally, leave blank: they are loaded automatically from Key Vault
# (mcp-gateway-client-id / mcp-gateway-tenant-id) using the KEYVAULT_URL below.
# Only set these here if you need to override the Key Vault values.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=

# Public base URL for OAuth discovery (registration_endpoint in /.well-known/oauth-authorization-server).
# Set to the externally-reachable URL in production (e.g. https://mcp.variant.dev).
# Defaults to http://{HOST}:{PORT} when unset — correct for local dev.
# AZURE_PUBLIC_URL=


# FlowCase — required for the get-cv-for-consultant resource.
# FLOWCASE_ORG:     your FlowCase subdomain (e.g. "variant" → variant.flowcase.com)
# FLOWCASE_API_KEY: API token from FlowCase admin settings
#
# Will be populated in KeyVault (login to your user), or override manually here.
# FLOWCASE_ORG=
# FLOWCASE_API_KEY=

# GitHub — required for the github-app-exists and github-deploy-app tools.
# Create a fine-grained PAT at GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens:
#   Resource owner: varianter
#   Repository access: Only select → varianter/external-artifacts + varianter/vibe-artifacts
#   Permissions: Contents = Read and write; Metadata = Read (auto-granted)
#
# Will be populated in KeyVault (login to your user), or override manually here.
# GITHUB_TOKEN=
