# Copy to .env for local development. Never commit .env.
# Public plugin defaults live in committed plugins/<plugin>/mcp-server.config.json.

# Local server address. Production should set HOST=0.0.0.0 in deployment env.
HOST=127.0.0.1
PORT=8080

# Public base URL for OAuth discovery.
# Defaults to http://{HOST}:{PORT}; set in production or when using a tunnel.
# PUBLIC_URL=https://your-mcp-server.example.com

# Auth deployment settings. Tenant/client IDs are not secrets, but usually differ per fork/environment.
# AUTH_TENANT_ID derives AUTH_ISSUER_URL automatically for Microsoft Entra ID.
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Optional: explicitly run unauthenticated locally (overrides the committed provider).
# AUTH_PROVIDER=none

# Optional local tooling only: used by `pnpm kv` to load secrets into .env. Not read by the server.
# KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/
