{
  "name": "@variant/plugin-standard-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:widget && concurrently \"node -e \\\"import('@variant/mcp-server/build-widgets')\\\" build-widgets --watch --mode development\" \"tsx watch --env-file ../../../.env src/index.ts\"",
    "dev:server": "tsx watch --env-file ../../../.env src/index.ts",
    "build": "pnpm run build:widget && tsc && cp -r src/assets dist/mcp/src/assets",
    "build:widget": "node -e \"import('@variant/mcp-server/build-widgets')\" build-widgets",
    "typecheck": "tsc --noEmit",
    "start": "node dist/mcp/src/index.js",
    "inspect": "npx @modelcontextprotocol/inspector --transport http --server-url http://127.0.0.1:8080/mcp",
    "jam": "pnpm dlx @mcpjam/inspector@latest --no-telemetry --config ../../../mcp.config.json --server plugin-mcp --oauth"
  },
  "dependencies": {
    "@variant/mcp-server": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "25.9.1",
    "concurrently": "^10.0.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
